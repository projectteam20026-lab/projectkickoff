# ─── MongoDB Atlas ──────────────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kickoff_jordan?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────────────────
# Use a strong random string (min 32 chars) — never commit the real value
JWT_SECRET=replace_with_strong_random_secret_key
JWT_EXPIRE=7d

# ─── Email (Gmail App Password) ─────────────────────────────────────────────
# Enable 2FA on your Gmail, then generate an App Password at myaccount.google.com
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=KickOff Jordan <your-email@gmail.com>

# ─── Frontend URL (password reset links) ────────────────────────────────────
# In production, set this to your Vercel deployment URL
CLIENT_URL=https://your-app.vercel.app

# ─── Environment ────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Gemini AI (optional — for AI assistant & stadium images) ───────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
